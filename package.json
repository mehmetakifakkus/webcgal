{
  "name": "webcgal",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "postbuild": "npm run check:bundle",
    "check:bundle": "node scripts/check-bundle.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test --trace off",
    "thumbnail:segmentIntersection": "node scripts/thumbnail.mjs",
    "thumbnail:triangulation": "node scripts/thumbnail.mjs --slug triangulation --preset \"Textbook polygon\" --step 60",
    "thumbnail:delaunay": "node scripts/thumbnail.mjs --slug delaunay --preset \"Textbook example\" --step 40",
    "thumbnail:voronoi": "node scripts/thumbnail.mjs --slug voronoi --preset \"Textbook example\" --step 37",
    "thumbnail:smallestEnclosingDisk": "node scripts/thumbnail.mjs --slug smallestEnclosingDisk --preset \"Random example\" --step 32",
    "thumbnail:kdTree": "node scripts/thumbnail.mjs --slug kdTree --preset \"Textbook example\" --step 46 --pad 0.82"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@uiw/react-codemirror": "^4.25.12",
    "codemirror": "^6.0.2",
    "paper": "0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/browser": "^5.1.0",
    "@vitest/browser-playwright": "^5.1.0",
    "playwright": "1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vitest-browser-react": "^2.3.0"
  }
}
